# Required by the API. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Paste the generated value here before starting Docker Compose.
# JWT_SECRET=

# Optional GitHub OAuth credentials. Required only for interactive sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8081
# WEB_ORIGIN=http://localhost:8081
# Optional Google OAuth credentials. The web client secret stays on the API.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_SECRET=
# GOOGLE_REDIRECT_URIS=http://localhost:8081
# GOOGLE_NATIVE_REDIRECT_URI=seaanimaldiscovery:/oauthredirect

# Optional local PostgreSQL overrides. Compose defaults are project03 / project03.
# POSTGRES_DB=project03
# POSTGRES_USER=project03
# POSTGRES_PASSWORD=change-me-local

# Optional Supabase connection. Uncomment and fill all settings to use Supabase
# instead of the local Compose database. Use the Session Pooler (port 5432).
# SPRING_DATASOURCE_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
# SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# SPRING_DATASOURCE_POOL_SIZE=5

# Expo client settings are public and are bundled into the app.
# Never put GitHub client secrets, database credentials, or JWT_SECRET here.
# Leave blank for localhost on web and the Expo host on Android; set a LAN URL for a physical device if needed.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:8081
# Local testing only. The API test-login endpoint exists only with the local Spring profile.
EXPO_PUBLIC_ENABLE_TEST_LOGIN=true
# Expo client settings are public and are bundled into the app.
# Never put GitHub client secrets, database credentials, or JWT_SECRET here.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:8081
# Google web credentials are public client IDs; never put a client secret here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081
# Android uses its native client ID and redirect URI in a development build.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_NATIVE_REDIRECT_URI=seaanimaldiscovery:/oauthredirect
